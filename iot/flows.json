    {
        "id": "chg_temp",
        "type": "change",
        "z": "tab_smart",
        "name": "Собрать TEMP",
        "rules": [
            {
                "t": "set",
                "p": "payload.sensor_id",
                "pt": "msg",
                "to": "TEMP-01",
                "tot": "str"
            },
            {
                "t": "set",
                "p": "payload.zone",
                "pt": "msg",
                "to": "server_room",
                "tot": "str"
            },
            {
                "t": "set",
                "p": "payload.timestamp",
                "pt": "msg",
                "to": "",
                "tot": "date"
            },
            {
                "t": "set",
                "p": "payload.value",
                "pt": "msg",
                "to": "25",
                "tot": "num"
            },
            {
                "t": "set",
                "p": "payload.unit",
                "pt": "msg",
                "to": "C",
                "tot": "str"
            },
            {
                "t": "set",
                "p": "headers",
                "pt": "msg",
                "to": "{\"Content-Type\":\"application/json\"}",
                "tot": "json"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 400,
        "y": 100,
        "wires": [
            [
                "http_ctrl_r",
                "http_stor_r",
                "sw_fan"
            ]
        ]
    },
