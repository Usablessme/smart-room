    {
        "id": "sw_fan",
        "type": "switch",
        "z": "tab_smart",
        "name": "Порог 30 °C",
        "property": "payload.value",
        "propertyType": "msg",
        "rules": [
            {
                "t": "lt",
                "v": "30",
                "vt": "num"
            },
            {
